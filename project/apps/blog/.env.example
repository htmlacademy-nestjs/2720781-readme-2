PORT=3001
POSTGRES_PORT=5432
POSTGRES_DB=readme_blog
POSTGRES_USER=readme
POSTGRES_PASSWORD=readme_password
DATABASE_URL=postgresql://readme:readme_password@127.0.0.1:5432/readme_blog?schema=public
PGADMIN_PORT=8082
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_password
JWT_SECRET=readme-demo-jwt-secret-at-least-32-bytes
COMMENT_SERVICE_URL=http://127.0.0.1:3002/api
RABBITMQ_URL=amqp://readme:readme_password@127.0.0.1:5672
RABBITMQ_QUEUE=readme.notify.email
RABBITMQ_USER_QUEUE=readme.user.notifications
RABBITMQ_BLOG_QUEUE=readme.blog.notifications
RABBITMQ_PREFETCH=10
RABBITMQ_TIMEOUT_MS=10000
