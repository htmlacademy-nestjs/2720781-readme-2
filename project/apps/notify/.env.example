PORT=3003
MONGO_PORT=27020
MONGO_USER=readme
MONGO_PASSWORD=readme_password
MONGO_DB=readme-notify
MONGO_URI=mongodb://readme:readme_password@127.0.0.1:27020/readme-notify?authSource=admin
RABBITMQ_USER=readme
RABBITMQ_PASSWORD=readme_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://readme:readme_password@127.0.0.1:5672
RABBITMQ_QUEUE=readme.notify.email
RABBITMQ_PREFETCH=10
SMTP_HOST=127.0.0.1
SMTP_PORT=8025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@readme.local
SMTP_TIMEOUT_MS=10000
FAKE_SMTP_HTTP_PORT=8080
NOTIFY_HTTP_TOKEN=readme-demo-notify-token-at-least-32-characters
JWT_SECRET=readme-demo-jwt-secret-at-least-32-bytes
NOTIFY_BATCH_SIZE=100
NOTIFY_LEASE_MS=300000
RABBITMQ_USER_QUEUE=readme.user.notifications
RABBITMQ_BLOG_QUEUE=readme.blog.notifications
RABBITMQ_TIMEOUT_MS=10000
MAILING_PAGE_SIZE=100
